# Front proxy of the demo container. It listens at once, so the hosting platform sees an open port while
# MySQL and Uptrail are still starting, and holds requests until Uptrail accepts connections.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Keep the X-Forwarded-* headers of the platform's edge (HTTPS, public host name).
		trusted_proxies static 0.0.0.0/0 ::/0
	}
	log {
		level ERROR
	}
}

:{$PORT:80} {
	reverse_proxy 127.0.0.1:8080 {
		# Uptrail reports ready only after the sample data is loaded.
		health_uri /actuator/health/readiness
		health_interval 1s
		health_timeout 2s
		lb_try_duration 240s
		lb_try_interval 500ms
	}
}
