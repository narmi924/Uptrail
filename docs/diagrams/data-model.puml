@startuml data-model
!pragma layout smetana
title Uptrail - data model (16 tables)
hide circle
skinparam shadowing false
skinparam defaultFontName Arial

entity users {
  * id (Java userId)
  --
  user_type (Staff / Manager / Admin)
  staff_id (unique), name, email
  user_name (unique), password_hash
  department, designation_code, active, enabled
}
entity user_roles {
  * user_id, role_code
}
entity approval_hierarchy {
  * employee_id
  --
  manager_id
}
entity course_category {
  * code
  --
  display_name, description
}
entity training_provider {
  * id
  --
  name, active
}
entity course_catalogue {
  * id
  --
  category_code, provider_id
  title, default_fee, active
}
entity training_calendar_year {
  * calendar_year
  --
  status (DRAFT / CONFIRMED)
  source_note, confirmed_by
}
entity excluded_days {
  * holiday_date
  --
  name, source_note
  calendar_year (generated)
}
entity training_entitlement {
  * id
  --
  employee_id + calendar_year (unique)
  entitled_units, budget_amount
}
entity course_application {
  * id
  --
  reference_no (unique)
  applicant_id, approver_id, reviewed_by
  category_code, course_title, provider_name
  start/end date and session, course_fee
  status, version
}
entity application_day {
  * application_id, training_date
  --
  units (1 or 2), session_code
}
entity course_fee_application {
  * id
  --
  application_id (unique)
  revision, amount, status
  approver_id, reviewed_by, reimbursed_by
  reimbursement_reference (unique)
}
entity claim_document {
  * id
  --
  claim_id + claim_revision + document_type (unique)
  storage_key (unique), sha256, size_bytes
}
entity audit_event {
  * id
  --
  aggregate_type, aggregate_key, event_type
  actor_employee_id, from_state, to_state
  reason, snapshot_json, correlation_id
}
entity training_ledger {
  * id
  --
  event_id + account_id (unique)
  application_id, claim_id, entry_type
  reserved/committed units and amounts
  reimbursed_amount
}
entity email_outbox {
  * id
  --
  event_id + recipient + template (unique)
  status, attempts, next_attempt_at
  lease_until, sent_at, last_error
}

users ||--o{ user_roles
users ||--o| approval_hierarchy
approval_hierarchy }o--|| users : manager
course_category ||--o{ course_catalogue
training_provider |o--o{ course_catalogue
training_calendar_year ||--o{ excluded_days
users ||--o{ training_entitlement
users ||--o{ course_application
course_application ||--|{ application_day
course_application ||--o| course_fee_application
course_fee_application ||--o{ claim_document
training_entitlement ||--o{ training_ledger
audit_event ||--o{ training_ledger
audit_event ||--o{ email_outbox
course_application |o--o{ training_ledger
course_fee_application |o--o{ training_ledger
@enduml
