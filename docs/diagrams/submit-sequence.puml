@startuml submit-sequence
title Submitting a course application
skinparam shadowing false
skinparam defaultFontName Arial

actor Staff
participant "Browser" as B
participant "StaffController" as C
participant "CourseApplicationService" as S
participant "ApplicationEvaluator" as E
participant "EntitlementService" as L
participant "AuditService" as A
participant "NotificationService" as N
database "MySQL" as DB
participant "OutboxWorker" as W
participant "SMTP" as M

Staff -> B : fill in the form
B -> B : live eligibility check\n(POST /api/v1/applications/preview)
Staff -> B : Submit application
B -> C : POST /staff/applications (CSRF, clientRequestId)
C -> S : submit(user, details, clientRequestId)
activate S
note over S, DB : one READ COMMITTED transaction
S -> DB : SELECT users FOR UPDATE
S -> DB : replayed request? (users + clientRequestId)
S -> E : evaluate(details)\n(dates, holidays, overlap, days, budget)
S -> L : lockAccounts(years, ascending)
L -> DB : SELECT training_entitlement FOR UPDATE
S -> E : re-check inside the locks
S -> DB : INSERT course_application, application_day
S -> A : record SUBMITTED
A -> DB : INSERT audit_event
S -> L : post RESERVE per year
L -> DB : INSERT training_ledger
S -> N : enqueue APPLICATION_SUBMITTED
N -> DB : INSERT email_outbox (PENDING)
S --> C : reference number
deactivate S
C --> B : redirect to the application page
... later ...
W -> DB : lease due rows (FOR UPDATE SKIP LOCKED)
W -> M : send plain-text mail with sign-in link
W -> DB : mark SENT, or schedule a retry
@enduml
