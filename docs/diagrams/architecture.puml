@startuml architecture
!pragma layout smetana
title Uptrail - components and call rules
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial

actor "Staff / Manager" as staff
actor "Administrator" as admin

node "Browser" {
  [Thymeleaf pages] as pages
  [JavaScript modules\n(preview, catalogue, calendar)] as js
}

node "Uptrail (Spring Boot)" {
  [Staff security chain\n/employee/login, /staff, /manager,\n/claims, /calendar, /api/v1] as staffChain
  [Admin security chain\n/admin/**] as adminChain
  [Page controllers\n(controller)] as web
  [REST controllers\n(controller, opt-in)] as api
  [Services\n(transactions, rules, scope,\naudit, ledger, outbox)] as services
  [Repositories\n(Spring Data JPA)] as repos
  [Outbox worker\n(scheduled)] as worker
  [Document store] as docs
}

database "MySQL 8.4\n(Flyway schema)" as db
folder "var/documents\n(private files)" as files
node "SMTP server\n(Mailpit locally)" as smtp

staff --> pages
admin --> pages
pages --> staffChain : HTML forms (CSRF)
js --> staffChain : JSON (CSRF)
pages --> adminChain
staffChain --> web
staffChain --> api
adminChain --> web
web --> services
api --> services
services --> repos
services --> docs
repos --> db
docs --> files
worker --> services : process due messages
worker --> smtp : plain-text mail
@enduml
