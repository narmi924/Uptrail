# Copy to .env and adjust. Docker Compose reads .env automatically; for the application, export the same
# variables in your shell (or rely on the defaults of the dev profile). Never commit a real .env file.

# Database (Docker Compose MySQL listens on 127.0.0.1:3307)
UPTRAIL_DB_PORT=3307
UPTRAIL_DB_USER=uptrail
UPTRAIL_DB_PASSWORD=change-me
UPTRAIL_DB_ROOT_PASSWORD=change-me-too
# UPTRAIL_DB_URL=jdbc:mysql://localhost:3307/uptrail?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

# Mail: "smtp" sends to the SMTP host (Mailpit locally); "file" writes .eml files to UPTRAIL_MAIL_CAPTURE_DIR
UPTRAIL_MAIL_TRANSPORT=smtp
UPTRAIL_MAIL_HOST=localhost
UPTRAIL_MAIL_PORT=1025
UPTRAIL_MAILPIT_UI_PORT=8025
# UPTRAIL_MAIL_CAPTURE_DIR=var/mail-capture

# Application
UPTRAIL_PORT=8080
UPTRAIL_BASE_URL=http://localhost:8080
# UPTRAIL_DOCUMENTS_ROOT=var/documents
# Password given to every sample-data account (dev profile only)
UPTRAIL_SAMPLE_PASSWORD=change-me
